# Copy to .env.local and fill in. Leave both blank to run in local mode
# (data stored only in your browser, no sign-in).
#
# Supabase → Project Settings → API. Use the anon / publishable key ONLY.
# NEVER put the service_role key in any NEXT_PUBLIC_ variable or commit it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
