# Copy to .env.local and fill in. Both values are required — the app stores all
# study data in Supabase and will show a configuration error without them.
#
# Supabase dashboard → Project Settings → API Keys (publishable key)
#                     and Data API (project URL).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional, legacy projects only: the old "anon" JWT key. Used only if
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is empty.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NEVER add the secret (sb_secret_…) or service_role key here or anywhere in
# this app — it bypasses Row Level Security. The app does not need it.
